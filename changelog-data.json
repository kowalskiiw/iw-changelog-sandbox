        "items": [
          {
            "type": "new",
            "title": "Typography Variable Collection eingeführt",
            "desc": "Alle Text Styles mit Figma Variables verknüpft. Typography / Primitives (interne Rohwerte) + Typography / Semantic (verwendbare Token). Dev Mode liefert ab sofort Token-Namen statt rohe px-Werte."
          }
        ]
      }
    ],
    "actions": [
      "Developer: Alle body-xl Implementierungen prüfen — Font Size ändert sich von 20px auf 18px.",
