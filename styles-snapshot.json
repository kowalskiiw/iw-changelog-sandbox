  "effect": {
    "Shadows/Extra Small": {
      "value": "drop shadow: offset 0/2 blur 5 color #000000 (5%) | drop shadow: offset 0/2 blur 7 color #000000 (5%)",
      "description": "The lowest elevation — a tight, barely-there shadow. For elements that need to lift off the background just slightly: input fields, tags, or subtle dividers between surfaces."
    },
    "Shadows/Base": {
      "value": "drop shadow: offset 0/5 blur 12 color #000000 (5%) | drop shadow: offset 0/2 blur 8 color #000000 (8%)",
      "description": "The default resting elevation for most raised surfaces — standard cards, list items, and containers sitting on a page. The everyday shadow when a component just needs to feel grounded."
    },
    "Background Blur/Small": {
      "value": "background blur: radius 10",
      "description": "The lightest frost. Gently softens whatever sits behind an element while keeping it recognisable — good for subtle glass effects on floating bars, sticky headers, or chips layered over content."
    },
    "Shadows/Medium": {
      "value": "drop shadow: offset 0/6 blur 12 color #000000 (8%) | drop shadow: offset 0/4 blur 16 color #000000 (5%)",
      "description": "A step up for interactive or temporarily raised surfaces — hover/active card states, dropdowns, and popovers. Signals that an element is above its neighbours."
    },
    "Background Blur/Medium": {
      "value": "background blur: radius 20",
      "description": "A moderate blur that noticeably obscures the background without fully hiding it. Suited to popovers, dropdowns, and smaller panels where you want depth and a frosted feel but still hint at the content underneath."
    },
    "Shadows/XLarge": {
      "value": "drop shadow: offset 0/20 blur 25 color #000000 (10%)",
      "description": "The highest elevation. Reserved for the most prominent overlays — modals, dialogs, and bottom sheets — where a strong, soft shadow separates them from everything behind."
    },
    "Background Blur/XLarge": {
      "value": "background blur: radius 100",
      "description": "A heavy blur that reduces the background to soft colour and shape. For full-screen scrims and modal backdrops where the goal is to pull focus firmly onto the foreground layer."
    },
    "Background Blur/XXLarge": {
      "value": "background blur: radius 120",
      "description": "The strongest blur — the background becomes an abstract wash of colour. Reserved for the most immersive overlays, onboarding takeovers, or loading/transition states where the content behind should all but disappear."
    },
    "Shadows/Large": {
      "value": "drop shadow: offset 0/10 blur 20 color #000000 (12%) | drop shadow: offset 0/4 blur 6 color #000000 (2%)",
      "description": "For floating overlays that clearly detach from the page — menus, tooltips, date pickers, and toasts. Noticeably deeper to read as on top of the content below."
    }
  },
